{
  "version": "0.2.77",
  "protocolVersion": "2025-06-18",
  "serverInfo": {
    "name": "docdex",
    "title": "Docdex – Repo Docs Index & Search",
    "version": "0.2.77"
  },
  "description": "Per-repo documentation indexer and search daemon that exposes fast search tools over MCP.",
  "iconUrl": "https://raw.githubusercontent.com/bekirdag/docdex/main/.well-known/icons/docdex-icon-512.png",
  "documentationUrl": "https://github.com/bekirdag/docdex",
  "transport": {
    "type": "streamable-http",
    "url": "http://127.0.0.1:28491/v1/mcp",
    "endpoint": "/v1/mcp"
  },
  "capabilities": {
    "tools": { "listChanged": false },
    "prompts": { "listChanged": false },
    "resources": { "listChanged": false }
  },
  "requires": {},
  "instructions": "Use docdex_search to find relevant docs, then docdex_open or docdex_files for details. Call docdex_index if results look stale.",
  "resources": ["dynamic"],
  "tools": ["dynamic"],
  "prompts": ["dynamic"]
}
