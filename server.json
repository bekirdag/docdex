{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bekirdag/docdex",
  "description": "Fast per-repo documentation indexer and full-text search MCP server for codebases.",
  "repository": {
    "url": "https://github.com/bekirdag/docdex",
    "source": "github"
  },
  "version": "0.2.40",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "docdex",
      "version": "0.2.40",
      "transport": {
        "type": "streamable-http",
        "url": "http://127.0.0.1:28491/v1/mcp",
        "endpoint": "/v1/mcp"
      }
    }
  ]
}
