# Copy to /etc/docdex/docdex.env on the server and replace placeholders there.
# Never commit the real file.
DOCDEX_STATE_DIR=/mnt/docdex/state
DOCDEX_AUTH_TOKEN=replace-with-server-generated-token
DOCDEX_ENABLE_MCP=true
DOCDEX_ENABLE_MEMORY=true
DOCDEX_CONVERSATION_MEMORY_ENABLED=true
DOCDEX_CONVERSATION_AUTO_CAPTURE=true
DOCDEX_PERSONAL_PREFERENCES_ENABLED=true
DOCDEX_PERSONAL_PREFERENCES_STORAGE_ROOT=/mnt/docdex/personal_preferences
DOCDEX_PERSONAL_PREFERENCES_CAPTURE_ENABLED=true
DOCDEX_PERSONAL_PREFERENCES_CAPTURE_CHAT_COMPLETIONS=true
DOCDEX_PERSONAL_PREFERENCES_CAPTURE_CONVERSATION_HOOKS=true
DOCDEX_PERSONAL_PREFERENCES_CAPTURE_IMPORTED_CONVERSATIONS=true
DOCDEX_PERSONAL_PREFERENCES_ARCHIVE_RAW=true
DOCDEX_PERSONAL_PREFERENCES_DIGEST_ENABLED=true
DOCDEX_PERSONAL_PREFERENCES_PROCESS_IN_BACKGROUND=true
DOCDEX_PERSONAL_PREFERENCES_CONTEXT_INJECTION_ENABLED=true
DOCDEX_PERSONAL_PREFERENCES_AUTO_PROJECT_SAFE_TO_PROFILE=true
DOCDEX_PERSONAL_PREFERENCES_SECRET_SCRUBBER_ENABLED=true
DOCDEX_WEB_ENABLED=1
DOCDEX_BROWSER_AUTO_INSTALL=1
DOCDEX_REPO_ENCRYPTION_WEB_DISCOVERY_ENABLED=true
DOCDEX_ACCESS_LOG=true
DOCDEX_AUDIT_LOG_PATH=/mnt/docdex/logs/audit.log
DOCDEX_AUDIT_MAX_BYTES=20000000
DOCDEX_AUDIT_MAX_FILES=10
DOCDEX_MIN_NOFILE_SOFT=8192
DOCDEX_REPO_IDLE_SECONDS=7200
DOCDEX_REPO_HIBERNATE_SECONDS=86400
DOCDEX_REPO_CLEANUP_INTERVAL_SECONDS=600
